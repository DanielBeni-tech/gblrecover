# PostgreSQL (GBL_* so host POSTGRES_* / DATABASE_URL from other projects are ignored)
GBL_POSTGRES_DB=gblrecover
GBL_POSTGRES_USER=postgres
GBL_POSTGRES_PASSWORD=postgres
DB_PORT=5433

# Backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8001
VITE_API_PREFIX=/api/v1
