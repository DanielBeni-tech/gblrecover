# URL de base de l'API GBLRecover (FastAPI, déployé sur Railway en prod).
# En développement local : http://localhost:8000
VITE_API_URL=http://localhost:8000

# Préfixe commun versionné de l'API (TRD §5.1)
VITE_API_PREFIX=/api/v1

# Mode démonstration : si "true", l'application bascule sur des données de
# démonstration locales quand l'API est injoignable ou renvoie 501.
# Recommandé : "true" pour la démo MVP sans backend, "false" en intégration.
VITE_DEMO_MODE=true
